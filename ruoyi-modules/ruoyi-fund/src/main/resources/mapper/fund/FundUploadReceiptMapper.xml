<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.fund.mapper.FundUploadReceiptMapper">
  <resultMap id="FundUploadReceiptResult" type="FundUploadReceipt">
    <id property="uploadToken" column="upload_token"/>
    <result property="fileName" column="file_name"/>
    <result property="originalName" column="original_name"/>
    <result property="fileUrl" column="file_url"/>
    <result property="fileSize" column="file_size"/>
    <result property="fileType" column="file_type"/>
    <result property="uploadUserId" column="upload_user_id"/>
    <result property="uploadTime" column="upload_time"/>
    <result property="expireTime" column="expire_time"/>
    <result property="usedFlag" column="used_flag"/>
    <result property="usedTime" column="used_time"/>
    <result property="businessType" column="business_type"/>
    <result property="businessId" column="business_id"/>
  </resultMap>

  <insert id="insert">
    insert into fund_upload_receipt
      (upload_token,file_name,original_name,file_url,file_size,file_type,
       upload_user_id,upload_time,expire_time,used_flag)
    values
      (#{uploadToken},#{fileName},#{originalName},#{fileUrl},#{fileSize},#{fileType},
       #{uploadUserId},#{uploadTime},#{expireTime},#{usedFlag})
  </insert>

  <select id="selectForUpdate" resultMap="FundUploadReceiptResult">
    select upload_token,file_name,original_name,file_url,file_size,file_type,
           upload_user_id,upload_time,expire_time,used_flag,used_time,business_type,business_id
    from fund_upload_receipt
    where upload_token=#{uploadToken}
    for update
  </select>

  <update id="markUsed">
    update fund_upload_receipt
    set used_flag='1',used_time=sysdate(),business_type=#{businessType},business_id=#{businessId}
    where upload_token=#{uploadToken} and used_flag='0'
  </update>
</mapper>
